<Window x:Class="diashow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="diashow" Width="1100" Height="700" Background="#101014"
        KeyDown="Window_KeyDown" MouseMove="Window_MouseMove"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Width" Value="52"/>
                <Setter Property="Height" Value="52"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#33FFFFFF"/>
                <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#66FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#99FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CompactIconButton" BasedOn="{StaticResource IconButton}" TargetType="Button">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="Margin" Value="3"/>
            </Style>
        </Grid.Resources>
        <Image x:Name="ImageView" Stretch="Uniform" Visibility="Collapsed"/>
        <MediaElement x:Name="VideoView" Stretch="Uniform" Visibility="Collapsed"
                      LoadedBehavior="Manual" UnloadedBehavior="Manual"
                      MediaEnded="VideoView_MediaEnded" MediaFailed="VideoView_MediaFailed"/>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock x:Name="EmptyMessage" Foreground="White" FontSize="24"
                       TextAlignment="Center" Margin="0,0,0,14"/>
            <Button Content="Choose folder..." Click="ChooseFolder_Click"
                    HorizontalAlignment="Center" Padding="16,7"/>
        </StackPanel>
        <Border Background="#66000000" Padding="16,10"
                HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <TextBlock x:Name="PathBanner" Foreground="White" FontSize="16"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <Border x:Name="Controls" Background="#CC17171C" Padding="14"
                VerticalAlignment="Bottom" Opacity="0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE100;" FontFamily="Segoe MDL2 Assets" ToolTip="Previous"
                            Click="Previous_Click"/>
                    <Button x:Name="PauseButton" Style="{StaticResource IconButton}" Content="&#xE769;" FontFamily="Segoe MDL2 Assets"
                            ToolTip="Pause" Click="Pause_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE101;" FontFamily="Segoe MDL2 Assets" ToolTip="Next"
                            Click="Next_Click"/>
                    <Button x:Name="AudioButton" Style="{StaticResource IconButton}" Content="&#xE767;" FontFamily="Segoe MDL2 Assets"
                            ToolTip="Unmute" Click="Audio_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE740;" FontFamily="Segoe MDL2 Assets" ToolTip="Fullscreen"
                            Click="Fullscreen_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="VideoToggle" Style="{StaticResource CompactIconButton}" Content="&#xE714;"
                            FontFamily="Segoe MDL2 Assets" ToolTip="Toggle videos" Click="VideoToggle_Click"/>
                    <Button Style="{StaticResource CompactIconButton}" Content="&#xE713;"
                            FontFamily="Segoe MDL2 Assets" ToolTip="Settings" Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="SettingsPanel" Background="#F01D1D24" Padding="24"
                Width="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Settings" Foreground="White" FontSize="22" Margin="0,0,0,16"/>
                <TextBlock Text="Image duration (seconds)" Foreground="White"/>
                <TextBox x:Name="DurationBox" Margin="0,4,0,12" TextChanged="SettingsControl_Changed"
                         LostFocus="SettingsControl_LostFocus"/>
                <TextBlock Text="Playback order" Foreground="White"/>
                <ComboBox x:Name="OrderBox" Margin="0,4,0,12" SelectionChanged="SettingsControl_Changed">
                    <ComboBoxItem Content="Filename order"/>
                    <ComboBoxItem Content="Random shuffle"/>
                </ComboBox>
                <TextBlock Text="Transition" Foreground="White"/>
                <ComboBox x:Name="TransitionBox" Margin="0,4,0,12" SelectionChanged="SettingsControl_Changed">
                    <ComboBoxItem Content="Instant switch"/>
                    <ComboBoxItem Content="Simple fade"/>
                </ComboBox>
                <TextBlock Text="Fade duration (seconds)" Foreground="White"/>
                <TextBox x:Name="FadeBox" Margin="0,4,0,18" TextChanged="SettingsControl_Changed"
                         LostFocus="SettingsControl_LostFocus"/>
                <CheckBox x:Name="PreloadBox" Content="Preload upcoming images"
                          Foreground="White" Margin="0,0,0,8"
                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed"/>
                <Button Content="Choose folder..." Click="ChooseFolder_Click" Margin="0,0,0,8"/>
                <Button Content="Close" Click="SaveSettings_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
