<Window x:Class="diashow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="diashow" Width="1100" Height="700" Background="#101014"
        KeyDown="Window_KeyDown" MouseMove="Window_MouseMove"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid x:Name="Root">
        <Image x:Name="ImageView" Stretch="Uniform" Visibility="Collapsed"/>
        <MediaElement x:Name="VideoView" Stretch="Uniform" Visibility="Collapsed"
                      LoadedBehavior="Manual" UnloadedBehavior="Manual"
                      MediaEnded="VideoView_MediaEnded" MediaFailed="VideoView_MediaFailed"/>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock x:Name="EmptyMessage" Foreground="White" FontSize="24"
                       TextAlignment="Center" Margin="0,0,0,14"/>
            <Button Content="Choose folder..." Click="ChooseFolder_Click"
                    HorizontalAlignment="Center" Padding="16,7"/>
        </StackPanel>

        <Border x:Name="Controls" Background="#CC17171C" Padding="14"
                VerticalAlignment="Bottom" Opacity="0">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="StatusText" Foreground="#D8D8E0" VerticalAlignment="Center"/>
                    <Button Content="Settings" Click="Settings_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                    <Button x:Name="VideoToggle" Content="Videos: on" Click="VideoToggle_Click"
                            DockPanel.Dock="Right" Margin="8,0,0,0"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Previous" Click="Previous_Click" Margin="4" Padding="14,6"/>
                    <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" Margin="4" Padding="14,6"/>
                    <Button Content="Next" Click="Next_Click" Margin="4" Padding="14,6"/>
                    <Button x:Name="AudioButton" Content="Unmute" Click="Audio_Click" Margin="4" Padding="14,6"/>
                    <Button Content="Fullscreen" Click="Fullscreen_Click" Margin="4" Padding="14,6"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="SettingsPanel" Background="#F01D1D24" Padding="24"
                Width="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Settings" Foreground="White" FontSize="22" Margin="0,0,0,16"/>
                <TextBlock Text="Image duration (seconds)" Foreground="White"/>
                <TextBox x:Name="DurationBox" Margin="0,4,0,12"/>
                <TextBlock Text="Playback order" Foreground="White"/>
                <ComboBox x:Name="OrderBox" Margin="0,4,0,12">
                    <ComboBoxItem Content="Filename order"/>
                    <ComboBoxItem Content="Random shuffle"/>
                </ComboBox>
                <TextBlock Text="Transition" Foreground="White"/>
                <ComboBox x:Name="TransitionBox" Margin="0,4,0,12">
                    <ComboBoxItem Content="Instant switch"/>
                    <ComboBoxItem Content="Simple fade"/>
                </ComboBox>
                <TextBlock Text="Fade duration (seconds)" Foreground="White"/>
                <TextBox x:Name="FadeBox" Margin="0,4,0,18"/>
                <Button Content="Choose folder..." Click="ChooseFolder_Click" Margin="0,0,0,8"/>
                <Button Content="Save and close" Click="SaveSettings_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
