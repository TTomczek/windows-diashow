<Window x:Class="diashow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diashow" Icon="{StaticResource AppIcon}" Width="1100" Height="700" Background="#101014"
        ToolTipService.IsEnabled="False"
        KeyDown="Window_KeyDown" PreviewKeyDown="Window_PreviewKeyDown" MouseMove="Window_MouseMove"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid x:Name="Root" ClipToBounds="True">
        <Grid.Resources>
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Width" Value="52"/>
                <Setter Property="Height" Value="52"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#33FFFFFF"/>
                <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#66FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#99FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CompactIconButton" BasedOn="{StaticResource IconButton}" TargetType="Button">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="Margin" Value="3"/>
            </Style>
            <Style x:Key="PreviewButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="OverlayButton" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#33FFFFFF"/>
                <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#66FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#99FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#33101014"/>
                <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="CaretBrush" Value="White"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#33101014"/>
                <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="7,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="DropDownButton"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              Foreground="{TemplateBinding Foreground}"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                <Grid>
                                                    <Path Data="M 0 0 L 8 0 L 4 4 Z"
                                                          Fill="{TemplateBinding Foreground}"
                                                          Width="8" Height="4"
                                                          HorizontalAlignment="Right"
                                                          Margin="0,0,9,0"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                <Popup x:Name="DropDown"
                                       AllowsTransparency="True"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                       PopupAnimation="Fade">
                                    <Border Background="#FF1D1D24"
                                            BorderBrush="#88FFFFFF"
                                            BorderThickness="1"
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer MaxHeight="240">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#FF1D1D24"/>
                <Setter Property="Padding" Value="7,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#55FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#77FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="5,3"/>
            </Style>
        </Grid.Resources>
        <Image x:Name="ImageView" Stretch="Uniform" Visibility="Collapsed"
               AutomationProperties.LiveSetting="Polite"/>
        <Image x:Name="IncomingImageView" Stretch="Uniform" Visibility="Collapsed"
               AutomationProperties.LiveSetting="Polite"/>
        <MediaElement x:Name="VideoView" Stretch="Uniform" Visibility="Collapsed"
                      LoadedBehavior="Manual" UnloadedBehavior="Manual"
                      AutomationProperties.LiveSetting="Polite"
                      MediaOpened="VideoView_MediaOpened"
                      MediaEnded="VideoView_MediaEnded" MediaFailed="VideoView_MediaFailed"/>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock x:Name="EmptyMessage" Foreground="White" FontSize="24"
                       TextAlignment="Center" Margin="0,0,0,14"/>
            <Button x:Name="ChooseFolderButton" Style="{StaticResource OverlayButton}" Content="Choose folder..." Click="ChooseFolder_Click"
                    HorizontalAlignment="Center" Padding="16,7"/>
        </StackPanel>
        <Border Background="#66000000" Padding="16,10"
                HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ItemCounter" Foreground="White" FontSize="16"
                           Margin="0,0,12,0"/>
                <TextBlock x:Name="PathBanner" Grid.Column="1" Foreground="White" FontSize="16"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
        <Button x:Name="AccessToast" Background="#E0A51D1D" BorderThickness="0"
                Padding="16,12" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,58,16,0" MaxWidth="620" Visibility="Collapsed"
                Click="AccessToast_Click" Panel.ZIndex="10"
                AutomationProperties.Name="Dismiss file error notification"
                AutomationProperties.LiveSetting="Assertive"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <StackPanel>
                <TextBlock x:Name="AccessToastType" Foreground="White" FontSize="15"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="AccessToastMessage" Foreground="White" FontSize="13"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="AccessToastDismissHint" Text="Press Enter, Space, or click to dismiss" Foreground="#DDFFFFFF" FontSize="11"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Button>

        <StackPanel x:Name="QueuePreviewHost" VerticalAlignment="Bottom" Margin="0" Panel.ZIndex="2"
                    Opacity="0" IsEnabled="False">
            <Button x:Name="QueueToggleButton" Style="{StaticResource CompactIconButton}"
                    Content="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                    ToolTip="Hide queue preview" AutomationProperties.Name="Hide queue preview"
                    HorizontalAlignment="Center" Click="QueueToggle_Click"/>
            <Border x:Name="QueuePreviewPanel" Background="#CC17171C" Padding="10,8"
                    Visibility="Collapsed" SizeChanged="QueuePreviewPanel_SizeChanged">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="QueuePreviousButton" Grid.Column="0"
                            Style="{StaticResource CompactIconButton}" Content="&#xE100;"
                            ToolTip="Previous preview item" AutomationProperties.Name="Previous preview item"
                            Click="QueuePrevious_Click"/>
                    <ScrollViewer x:Name="QueuePreviewScroller" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  HorizontalAlignment="Center" Focusable="False">
                        <StackPanel x:Name="QueuePreviewItems" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ScrollViewer>
                    <Button x:Name="QueueNextButton" Grid.Column="2"
                            Style="{StaticResource CompactIconButton}" Content="&#xE101;"
                            ToolTip="Next preview item" AutomationProperties.Name="Next preview item"
                            Click="QueueNext_Click"/>
                </Grid>
            </Border>
        </StackPanel>

        <Border x:Name="Controls" Background="#CC17171C" Padding="14"
                VerticalAlignment="Bottom" Opacity="0" IsEnabled="False"
                SizeChanged="Controls_SizeChanged">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Slider x:Name="VideoProgress" Grid.Row="0" Height="24" Margin="0,0,0,8"
                        Minimum="0" Maximum="1" SmallChange="10" LargeChange="10"
                        Visibility="Collapsed" IsTabStop="True"
                        ToolTip="Video position"
                        ValueChanged="VideoProgress_ValueChanged"
                        PreviewMouseLeftButtonDown="VideoProgress_PreviewMouseLeftButtonDown"
                        PreviewKeyDown="VideoProgress_PreviewKeyDown"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PreviousButton" Style="{StaticResource IconButton}" Content="&#xE100;" FontFamily="Segoe MDL2 Assets" ToolTip="Previous"
                            AutomationProperties.Name="Previous item"
                            Click="Previous_Click"/>
                    <Button x:Name="PauseButton" Style="{StaticResource IconButton}" Content="&#xE769;" FontFamily="Segoe MDL2 Assets"
                            ToolTip="Pause" AutomationProperties.Name="Pause" Click="Pause_Click"/>
                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE101;" FontFamily="Segoe MDL2 Assets" ToolTip="Next"
                            AutomationProperties.Name="Next item"
                            Click="Next_Click"/>
                    <Button x:Name="AudioButton" Style="{StaticResource IconButton}" Content="&#xE767;" FontFamily="Segoe MDL2 Assets"
                            ToolTip="Unmute" AutomationProperties.Name="Unmute" Click="Audio_Click"/>
                    <Button x:Name="RevealButton" Style="{StaticResource IconButton}" Content="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                            ToolTip="Reveal in explorer" AutomationProperties.Name="Reveal current file in Explorer"
                            Click="RevealInExplorer_Click"/>
                    <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Content="&#xE740;" FontFamily="Segoe MDL2 Assets" ToolTip="Fullscreen"
                            AutomationProperties.Name="Toggle fullscreen" Click="Fullscreen_Click"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="VideoToggle" Style="{StaticResource CompactIconButton}"
                            FontFamily="Segoe MDL2 Assets" ToolTip="Cycle media filter"
                            AutomationProperties.Name="Cycle media filter" Click="VideoToggle_Click"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource CompactIconButton}" Content="&#xE713;"
                            FontFamily="Segoe MDL2 Assets" ToolTip="Settings"
                            AutomationProperties.Name="Settings" Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="SettingsPanel" Background="#F01D1D24" Padding="24"
                Width="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                MaxHeight="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight}"
                Visibility="Collapsed" Panel.ZIndex="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Padding="0,0,10,0">
                <StackPanel>
                <TextBlock x:Name="SettingsTitle" Text="Settings" Foreground="White" FontSize="22" Margin="0,0,0,16"/>
                <TextBlock x:Name="ImageDurationLabel" Text="Image duration (seconds)" Foreground="White"/>
                <TextBox x:Name="DurationBox" Margin="0,4,0,12"
                         AutomationProperties.Name="Image duration in seconds"
                         TextChanged="SettingsControl_Changed"
                         LostFocus="SettingsControl_LostFocus"/>
                <TextBlock x:Name="PlaybackOrderLabel" Text="Playback order" Foreground="White"/>
                <ComboBox x:Name="OrderBox" Margin="0,4,0,12"
                          AutomationProperties.Name="Playback order"
                          SelectionChanged="SettingsControl_Changed">
                    <ComboBoxItem x:Name="FilenameOrderItem" Content="Filename order"/>
                <ComboBoxItem x:Name="CreationDateOrderItem" Content="Creation date"/>
                <ComboBoxItem x:Name="RandomShuffleItem" Content="Random shuffle"/>
                </ComboBox>
                <TextBlock x:Name="SortDirectionLabel" Text="Sort direction" Foreground="White"/>
                <ComboBox x:Name="DirectionBox" Margin="0,4,0,12"
                      AutomationProperties.Name="Sort direction"
                      SelectionChanged="SettingsControl_Changed">
                <ComboBoxItem x:Name="AscendingItem" Content="Ascending"/>
                <ComboBoxItem x:Name="DescendingItem" Content="Descending"/>
                </ComboBox>
                <TextBlock x:Name="TransitionLabel" Text="Transition" Foreground="White"/>
                <ComboBox x:Name="TransitionBox" Margin="0,4,0,12"
                          AutomationProperties.Name="Transition"
                          SelectionChanged="SettingsControl_Changed">
                    <ComboBoxItem x:Name="InstantSwitchItem" Content="Instant switch"/>
                    <ComboBoxItem x:Name="SimpleFadeItem" Content="Simple fade"/>
                    <ComboBoxItem x:Name="SlideItem" Content="Slide left"/>
                    <ComboBoxItem x:Name="KenBurnsItem" Content="Ken Burns"/>
                    <ComboBoxItem x:Name="CrossfadeItem" Content="Crossfade"/>
                    <ComboBoxItem x:Name="ZoomItem" Content="Zoom"/>
                    <ComboBoxItem x:Name="CoverItem" Content="Cover"/>
                    <ComboBoxItem x:Name="BlurDissolveItem" Content="Blur dissolve"/>
                </ComboBox>
                <TextBlock x:Name="FadeDurationLabel" Text="Fade duration (seconds)" Foreground="White"/>
                <TextBox x:Name="FadeBox" Margin="0,4,0,18"
                         AutomationProperties.Name="Fade duration in seconds"
                         TextChanged="SettingsControl_Changed"
                         LostFocus="SettingsControl_LostFocus"/>
                <TextBlock x:Name="LanguageLabel" Text="Language" Foreground="White"/>
                <ComboBox x:Name="LanguageBox" Margin="0,4,0,12"
                          AutomationProperties.Name="Language"
                          SelectionChanged="LanguageBox_SelectionChanged">
                    <ComboBoxItem Content="English" Tag="en"/>
                    <ComboBoxItem Content="Deutsch" Tag="de"/>
                    <ComboBoxItem Content="Español" Tag="es"/>
                </ComboBox>
                <CheckBox x:Name="PreloadBox" Content="Preload upcoming images"
                          Foreground="White" Margin="0,0,0,8"
                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed"/>
                <TextBlock x:Name="KeyboardShortcutsLabel" Text="Keyboard shortcuts" Foreground="White" FontSize="18"
                           Margin="0,8,0,8"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Space" Foreground="White" Margin="0,2,16,2"/>
                    <TextBlock x:Name="PauseOrResumeShortcut" Grid.Column="1" Text="Pause or resume" Foreground="#FFCCCCCC" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Text="Left / Right" Foreground="White" Margin="0,2,16,2"/>
                    <TextBlock x:Name="PreviousNextShortcut" Grid.Row="1" Grid.Column="1" Text="Previous / next item" Foreground="#FFCCCCCC" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="2" Text="Slider arrows" Foreground="White" Margin="0,2,16,2"/>
                    <TextBlock x:Name="SeekShortcut" Grid.Row="2" Grid.Column="1" Text="Seek 10 seconds" Foreground="#FFCCCCCC" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="3" Text="F" Foreground="White" Margin="0,2,16,2"/>
                    <TextBlock x:Name="FullscreenShortcut" Grid.Row="3" Grid.Column="1" Text="Toggle fullscreen" Foreground="#FFCCCCCC" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="4" Text="V" Foreground="White" Margin="0,2,16,2"/>
                    <TextBlock x:Name="MediaShortcut" Grid.Row="4" Grid.Column="1" Text="Cycle images, videos, or both" Foreground="#FFCCCCCC" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="5" Text="M" Foreground="White" Margin="0,2,16,2"/>
                    <TextBlock x:Name="MuteShortcut" Grid.Row="5" Grid.Column="1" Text="Mute or unmute video" Foreground="#FFCCCCCC" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="6" Text="Escape" Foreground="White" Margin="0,2,16,2"/>
                    <TextBlock x:Name="CloseShortcut" Grid.Row="6" Grid.Column="1" Text="Close settings or exit fullscreen" Foreground="#FFCCCCCC" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="7" Text="E" Foreground="White" Margin="0,2,16,2"/>
                    <TextBlock x:Name="RevealShortcut" Grid.Row="7" Grid.Column="1" Text="Reveal current file in Explorer" Foreground="#FFCCCCCC" Margin="0,2" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="8" Text="Q" Foreground="White" Margin="0,2,16,2"/>
                    <TextBlock x:Name="QueuePreviewShortcut" Grid.Row="8" Grid.Column="1" Text="Show or hide queue preview" Foreground="#FFCCCCCC" Margin="0,2" TextWrapping="Wrap"/>
                </Grid>
                <Button x:Name="ChooseFolderSettingsButton" Style="{StaticResource OverlayButton}" Content="Choose folder..." Click="ChooseFolder_Click" Margin="0,0,0,8"/>
                <Button x:Name="CloseSettingsButton" Style="{StaticResource OverlayButton}" Content="Close" Click="SaveSettings_Click"/>
                <TextBlock x:Name="VersionLabel" Foreground="#99FFFFFF" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
