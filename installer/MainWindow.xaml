<Window x:Class="Diashow.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install Diashow" Width="520" Height="330"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Install Diashow" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,18"
                   Text="Choose where to install the latest version from GitHub."
                   TextWrapping="Wrap"/>
        <TextBlock Grid.Row="2" Text="Installation folder"/>
        <Grid Grid.Row="3" Margin="0,5,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InstallPathTextBox" Padding="6" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,5"
                    Content="Browse..." Click="Browse_Click"/>
        </Grid>
        <StackPanel Grid.Row="4">
            <CheckBox x:Name="ContextMenuCheckBox" IsChecked="True"
                      Content="Add Diashow to the File Explorer context menu" Margin="0,0,0,8"/>
            <CheckBox x:Name="StartMenuCheckBox" IsChecked="True"
                      Content="Add Diashow to the Windows Start menu"/>
        </StackPanel>
        <ProgressBar x:Name="DownloadProgressBar" Grid.Row="5" Height="8"
                     Margin="0,18,0,0" Minimum="0" Maximum="1"
                     IsIndeterminate="True"/>
        <Grid Grid.Row="6" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="InstallButton" HorizontalAlignment="Right" Padding="18,7"
                    Content="Install" Click="Install_Click" IsDefault="True" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
